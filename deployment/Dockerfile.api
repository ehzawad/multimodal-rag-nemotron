FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app HOME=/home/mmrag
WORKDIR /app
COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt && pip check \
 && pip freeze > /app/installed-requirements.txt \
 && useradd --uid 10001 --create-home mmrag \
 && mkdir -p /data/indexes /gpu-lock && chown -R 10001:10001 /data /gpu-lock
COPY stack ./stack
USER 10001:10001
CMD ["uvicorn", "stack.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "24", "--timeout-graceful-shutdown", "610"]
