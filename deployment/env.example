# Use python manage.py init-env instead of reusing these placeholders.
API_KEY=replace-with-a-long-random-application-key
ADMIN_KEY=replace-with-a-different-long-random-admin-key
POSTGRES_PASSWORD=replace-with-a-random-database-password
DEPLOYMENT_REVISION=record-the-git-commit
HTTP_PORT=8080
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.07-py3
VLLM_IMAGE=vllm/vllm-openai:v0.27.0
# Same-GPU defaults are an UNBENCHMARKED capacity starting point, not a fit guarantee.
EMBED_GPU=0
RERANK_GPU=0
GEN_GPU=0
GPU_SERIALIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.44
VLLM_MAX_MODEL_LEN=8192
MODEL_MICROBATCH=2

# Raise these only after moving models to independent GPUs and measuring capacity.
MODEL_API_CONCURRENCY=1
RAG_CONCURRENCY=1
VLLM_MAX_NUM_SEQS=1
